# Deny by default: only what is explicitly allowed below can be added to git.
# Local test artifacts, secrets (.env), and tooling stay out without a rule
# for each one. Tracked files are unaffected.
/*
!/.claude-plugin/
!/.claude-plugin/**
!/hooks/
!/hooks/**
!/.github/
!/.github/**
!/benchmarks/
!/benchmarks/**
!/docs/
!/docs/**
!/service/
!/service/**
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/skills/clean-user-facing-text/
!/skills/clean-user-facing-text/**
!/tests/
!/tests/**
!/.coderabbit.yaml
!/.dockerignore
!/.env.example
!/.gitignore
!/.pre-commit-hooks.yaml
!/CODE_OF_CONDUCT.md
!/compose-check.sh
!/compose.yaml
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/pytest.ini
!/README.md
!/requirements-dev.txt
!/ruff.toml
!/SECURITY.md
!/stealer/
!/stealer/**

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
# The stealer's downloaded prompt corpus is generated data, not source.
stealer/prompts/
stealer/prompts/**
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak
