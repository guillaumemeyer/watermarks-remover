{
  "description": "After the agent writes a file, report (or strip) AI/C2PA provenance marks in it.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.js"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
